index 0000000..995e85a
--- /dev/null
+++ b/src/checker/eval_front.rs
@@ -0,0 +1,106 @@
+//! Experimental exact-expression/original-environment front cache.
+use crate::checker::cache::Reset;
+use crate::checker::value::{E, V};
+use crate::term::id::ExprId;
+
+const PAGE_BITS: usize = 7;
+const PAGE_LEN: usize = 1 << PAGE_BITS;
+
+#[derive(Clone, Copy, Default)]
+struct Slot {
+    generation: u32,
+    env: E,
+    result: V,
+}
+
+pub(crate) struct EvalFront {
+    pages: [Vec<Option<Box<[Slot; PAGE_LEN]>>>; 2],
+    generation: u32,
+}
+
+impl EvalFront {
+    #[inline(always)]
+    pub(crate) fn get(&self, e: ExprId, env: E) -> Option<V> {
+        let index = e.index();
+        let page = self.pages[usize::from(e.is_local())].get(index >> PAGE_BITS)?.as_ref()?;
+        let slot = page[index & (PAGE_LEN - 1)];
+        (slot.generation == self.generation && slot.env == env).then_some(slot.result)
+    }
+
+    pub(crate) fn insert(&mut self, e: ExprId, env: E, result: V) {
+        let index = e.index();
+        let pages = &mut self.pages[usize::from(e.is_local())];
+        let pi = index >> PAGE_BITS;
+        if pages.len() <= pi {
+            pages.resize_with(pi + 1, || None);
+        }
+        let page = pages[pi].get_or_insert_with(|| Box::new([Slot::default(); PAGE_LEN]));
+        page[index & (PAGE_LEN - 1)] = Slot { generation: self.generation, env, result };
+    }
+}
+
+impl Reset for EvalFront {
+    fn with_cap(_: usize) -> Self {
+        Self { pages: [Vec::new(), Vec::new()], generation: 1 }
+    }
+
+    fn reset(&mut self) {
+        if self.generation == u32::MAX {
+            self.pages = [Vec::new(), Vec::new()];
+            self.generation = 1;
+        } else {
+            self.generation += 1;
+        }
+    }
+
+    fn reset_shrink(&mut self) {
+        self.pages = [Vec::new(), Vec::new()];
+        self.generation = 1;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::checker::value::{EMPTY_ENV, Vals};
+    use crate::term::id::ZERO;
+
+    // Removing expression or environment identity must change these outcomes.
+    #[test]
+    fn cached_result_requires_exact_expression_and_environment() {
+        let mut vals = Vals::new();
+        let v = vals.mk_sort(ZERO);
+        let env = vals.env_push(EMPTY_ENV, v);
+        let e = ExprId::new(129, false);
+        let local = ExprId::new(129, true);
+        let other = ExprId::new(257, false);
+        let mut cache = EvalFront::with_cap(0);
+        cache.insert(e, env, v);
+        assert_eq!(cache.get(e, env), Some(v));
+        assert_eq!(cache.get(e, EMPTY_ENV), None);
+        assert_eq!(cache.get(local, env), None);
+        assert_eq!(cache.get(other, env), None);
+        cache.insert(local, EMPTY_ENV, v);
+        cache.insert(other, EMPTY_ENV, v);
+        assert_eq!(cache.get(e, env), Some(v));
+        assert_eq!(cache.get(local, EMPTY_ENV), Some(v));
+        assert_eq!(cache.get(other, EMPTY_ENV), Some(v));
+    }
+
+    // Losing either reset would return a stale V after a namespace/session change.
+    #[test]
+    fn resets_invalidate_results_before_value_ids_can_be_reused() {
+        let mut vals = Vals::new();
+        let v = vals.mk_sort(ZERO);
+        let e = ExprId::new(7, false);
+        let mut cache = EvalFront::with_cap(0);
+        cache.insert(e, EMPTY_ENV, v);
+        assert_eq!(cache.get(e, EMPTY_ENV), Some(v));
+        cache.reset();
+        assert_eq!(cache.get(e, EMPTY_ENV), None);
+        cache.insert(e, EMPTY_ENV, v);
+        assert_eq!(cache.get(e, EMPTY_ENV), Some(v));
+        cache.reset_shrink();
+        assert_eq!(cache.get(e, EMPTY_ENV), None);
+    }
+}
