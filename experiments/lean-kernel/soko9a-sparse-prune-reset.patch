+/// Preserve exact direct-mapped prune semantics, clear only slots written.
+pub(crate) struct PruneMemo {
+    slots: Box<[(u64, E, E); PRUNE_DM_LEN]>,
+    touched: Vec<usize>,
+    written: Box<[bool; PRUNE_DM_LEN]>,
+}
+
+impl Reset for PruneMemo {
+    fn with_cap(_: usize) -> Self {
+        Self {
+            slots: Box::new([Default::default(); PRUNE_DM_LEN]),
+            touched: Vec::new(),
+            written: Box::new([false; PRUNE_DM_LEN]),
+        }
+    }
+
+    fn reset(&mut self) {
+        for slot in self.touched.drain(..) {
+            self.slots[slot] = Default::default();
+            self.written[slot] = false;
+        }
+    }
+
+    fn reset_shrink(&mut self) { self.reset(); }
+}
+
+impl PruneMemo {
+    #[inline(always)]
+    pub(crate) fn get(&self, slot: usize) -> (u64, E, E) { self.slots[slot] }
+
+    #[inline(always)]
+    pub(crate) fn put(&mut self, slot: usize, item: (u64, E, E)) {
+        if !self.written[slot] {
+            self.written[slot] = true;
+            self.touched.push(slot);
+        }
+        self.slots[slot] = item;
+    }
+}
+
