+#[cfg(test)]
+mod right_spine_tests {
+    use crate::checker::env::EnvLimit;
+    use crate::checker::value::EMPTY_ENV;
+    use crate::config::Config;
+    use crate::frontend::parser::parse_export_mapped;
+    use crate::term::id::ZERO;
+
+    #[test]
+    fn typed_identity_right_spines_preserve_values_across_cutoff_and_saturation() {
+        let export = parse_export_mapped(b"{\"ie\":0,\"sort\":0}\n", Config::default()).unwrap();
+        export.with_ctx(|ctx, cache, _| {
+            ctx.with_tc(EnvLimit::ByIndex(0), cache, |tc| {
+                let one = tc.ctx.succ(ZERO);
+                let domain = tc.ctx.mk_sort(one);
+                let var = tc.ctx.mk_var(0);
+                let identity = tc.ctx.mk_lambda(domain, var);
+                // Prop : Sort 1, so each identity application has the same valid type.
+                let mut chain = tc.ctx.mk_sort(ZERO);
+                let expected = tc.mk_sort_hc(ZERO);
+                for n in 1..=65537 {
+                    chain = tc.ctx.mk_app(identity, chain);
+                    if matches!(n, 1 | 2 | 63 | 64 | 65 | 4096 | 65535 | 65536 | 65537) {
+                        assert_eq!(tc.eval(0, EMPTY_ENV, chain), expected, "right chain of {n}");
+                    }
+                }
+            });
+        });
+    }
+}
