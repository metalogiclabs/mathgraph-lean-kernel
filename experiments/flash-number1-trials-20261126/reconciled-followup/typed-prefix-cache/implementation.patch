+    const SOURCE: &str = r#"{"in":1,"str":{"pre":0,"str":"A"}}
+{"il":1,"succ":0}
+{"ie":0,"sort":1}
+{"axiom":{"name":1,"type":0,"levelParams":[],"isUnsafe":false}}
+{"ie":1,"const":{"name":1,"us":[]}}
