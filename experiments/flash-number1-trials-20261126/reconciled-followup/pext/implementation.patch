+#[cfg(target_arch = "x86_64")]
+#[target_feature(enable = "bmi2")]
+unsafe fn selected_ranks(selected: u64, frame: u64) -> u64 {
+    std::arch::x86_64::_pext_u64(selected, frame)
+}
+
+#[cfg(all(test, target_arch = "x86_64"))]
+mod rank_selection_tests {
+    use super::selected_ranks;
+
+    #[test]
+    fn hardware_selection_preserves_source_slot_order() {
+        if !std::is_x86_feature_detected!("bmi2") { return; }
+        for frame in 0u64..256 {
+            for selection in 0u64..256 {
+                let selection = selection & frame;
+                let positions: Vec<_> = (0..8).filter(|bit| frame & (1 << bit) != 0).collect();
+                let expected = positions.iter().enumerate().filter(|(_, bit)| selection & (1 << *bit) != 0)
+                    .map(|(rank, _)| 1u64 << rank).sum::<u64>();
+                assert_eq!(unsafe { selected_ranks(selection, frame) }, expected);
+            }
+        }
+        // High near positions and the FAR marker participate in rank order,
+        // while an unselected FAR marker never creates a packed slot.
+        for shift in [1, 29, 54, 55] {
+            let frame = (0b10110101u64 << shift) | (1u64 << 63);
+            let selected = (0b10000100u64 << shift) & frame;
+            assert_eq!(unsafe { selected_ranks(selected, frame) }, 0b10010);
+        }
+    }
+}
