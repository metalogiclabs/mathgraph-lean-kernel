+// Only a successful semantic support check authorizes argument-independent
+// reuse. Closures, suspensions and exhausted checks keep the original path.
+// An outer neutral's type was fixed before the new binder was introduced.
+fn result_uses_only_outer_variables(v: V<'_>, cutoff: u32, fuel: &mut u16) -> bool {
+    if *fuel == 0 {
+        return false;
+    }
+    *fuel -= 1;
+    let mut spine = match v {
+        Value::Sort { .. } | Value::NatLit { .. } | Value::StrLit { .. } => return true,
+        Value::Rigid { head: RigidHead::BVar(level, _), spine, .. } => {
+            if *level >= cutoff {
+                return false;
+            }
+            *spine
+        }
+        Value::Rigid { spine, .. } | Value::Unfold { spine, .. } => *spine,
+        Value::Lam { .. } | Value::Pi { .. } | Value::Thunk { .. } => return false,
+    };
+    while let Spine::Snoc { prev, elim, .. } = spine {
+        if *fuel == 0 {
+            return false;
+        }
+        *fuel -= 1;
+        if let ElimView::App(arg) = elim.view() {
+            if !result_uses_only_outer_variables(arg, cutoff, fuel) {
+                return false;
+            }
+        }
+        spine = prev;
+    }
+    true
+}
