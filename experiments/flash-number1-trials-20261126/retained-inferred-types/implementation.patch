+#[test]
+fn retained_result_preserves_the_actual_outer_type_capture() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let two = tc.ctx.succ(one);
+        let variable = tc.ctx.mk_var(0);
+        let identity = tc.ctx.mk_lambda(variable, variable);
+        let mut results = Vec::new();
+        for level in [one, two] {
+            let universe = crate::value::mk_sort(tc.arena, level);
+            let outer = tc.mk_bvar_hc(0, universe);
+            let env = tc.env_extend(tc.empty_env(), outer);
+            let ctx = crate::value::ctx_extend(tc.arena, tc.empty_ctx(), universe);
+            let ty = tc.infer_value(crate::tc::InferFlag::Check, 1, env, ctx, identity);
+            let crate::value::Value::Pi { body, .. } = ty else { panic!("identity type was not Pi") };
+            let argument = tc.mk_bvar_hc(1, outer);
+            let result = tc.apply_closure(2, body, argument, None);
+            assert!(std::ptr::eq(result, outer));
+            results.push(result);
+        }
+        assert!(!std::ptr::eq(results[0], results[1]));
+    }))
+}
