+#[test]
+fn checked_constant_result_type_needs_no_body_reinference() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let prop = tc.ctx.prop();
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let universe = tc.ctx.mk_sort(one);
+        let term = tc.ctx.mk_lambda(universe, prop);
+        let ty = tc.infer_value(crate::tc::InferFlag::Check, 0, tc.empty_env(), tc.empty_ctx(), term);
+        let crate::value::Value::Pi { body, .. } = ty else { panic!("lambda type was not Pi") };
+        let argument = tc.eval(0, tc.empty_env(), prop);
+        let result = tc.apply_closure(1, body, argument, None);
+        assert!(matches!(result, crate::value::Value::Sort { level, .. } if *level == one));
+    }))
+}
