+#[test]
+fn reconstructed_syntax_keeps_lambda_domains_and_variable_identity() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let prop = tc.ctx.prop();
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let universe = tc.ctx.mk_sort(one);
+        let zero = tc.ctx.mk_var(0);
+        let other = tc.ctx.mk_var(1);
+        let source = tc.ctx.mk_lambda(prop, zero);
+        let copied = crate::util::ExprPtr::local(tc.arena.alloc(*source.as_ref()));
+        let forged_domain = tc.ctx.mk_lambda(universe, zero);
+        let forged_body = tc.ctx.mk_lambda(prop, other);
+        assert_ne!(source, copied);
+        assert!(crate::expr::same_source_syntax(source, copied, 8));
+        assert!(!crate::expr::same_source_syntax(source, copied, 0));
+        assert!(!crate::expr::same_source_syntax(source, forged_domain, 8));
+        assert!(!crate::expr::same_source_syntax(source, forged_body, 8));
+    }))
+}
