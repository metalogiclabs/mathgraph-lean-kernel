 pub(crate) const NAT_LIT_HASH: u64 = 1583;
 
+// A bounded, sufficient condition for expression identity across the imported
+// and reconstructed arenas. Every semantic field, including lambda domains,
+// participates. Pointer inequality and exhausted work never imply inequality:
+// callers retain the ordinary conversion check on a false result.
+pub(crate) fn same_source_syntax(a: ExprPtr<'_>, b: ExprPtr<'_>, mut budget: usize) -> bool {
+    let mut pending = smallvec::SmallVec::<[(ExprPtr<'_>, ExprPtr<'_>); 16]>::new();
+    pending.push((a, b));
+    while let Some((a, b)) = pending.pop() {
+        if a == b { continue; }
+        if budget == 0 { return false; }
+        budget -= 1;
+        match (*a.as_ref(), *b.as_ref()) {
+            (Var { dbj_idx: a, .. }, Var { dbj_idx: b, .. }) if a == b => {}
+            (Sort { level: a, .. }, Sort { level: b, .. }) if a == b => {}
+            (Const { name: a, levels: u, .. }, Const { name: b, levels: v, .. })
+                if a == b && u.as_ref() == v.as_ref() => {}
+            (NatLit { ptr: a, .. }, NatLit { ptr: b, .. }) if a == b => {}
+            (StringLit { ptr: a, .. }, StringLit { ptr: b, .. }) if a == b => {}
+            (App { fun: a, arg: x, .. }, App { fun: b, arg: y, .. }) => {
+                pending.push((a, b)); pending.push((x, y));
+            }
+            (Pi { binder_type: a, body: x, .. }, Pi { binder_type: b, body: y, .. })
+            | (Lambda { binder_type: a, body: x, .. }, Lambda { binder_type: b, body: y, .. }) => {
+                pending.push((a, b)); pending.push((x, y));
+            }
+            (Proj { ty_name: a, idx: i, structure: x, .. }, Proj { ty_name: b, idx: j, structure: y, .. })
+                if a == b && i == j => pending.push((x, y)),
+            (Let { data: a, .. }, Let { data: b, .. }) if a.nondep == b.nondep => {
+                pending.push((a.binder_type, b.binder_type));
+                pending.push((a.val, b.val)); pending.push((a.body, b.body));
+            }
+            _ => return false,
+        }
+    }
+    true
+}
