+#[test]
+fn unused_lambda_binder_preserves_outer_variables() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let prop = tc.ctx.prop();
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let domain = tc.ctx.mk_sort(one);
+        let body = tc.ctx.mk_var(1);
+        let function = tc.ctx.mk_lambda(domain, body);
+        let application = tc.ctx.mk_app(function, prop);
+        let expected = crate::value::mk_sort(tc.arena, one);
+        let env = tc.env_extend(tc.empty_env(), expected);
+        assert!(std::ptr::eq(tc.eval(1, env, application), expected));
+    }))
+}
