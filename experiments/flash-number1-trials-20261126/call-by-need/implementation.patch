+            Expr::Var { dbj_idx, .. } => return env.lookup(*dbj_idx).expect("delay_arg: loose bvar"),
+            Expr::Sort { .. } | Expr::Const { .. } | Expr::NatLit { .. } | Expr::StringLit { .. } => {
