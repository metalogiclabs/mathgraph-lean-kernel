+#[cfg(test)]
+mod block_receipt_tests {
+    use super::*;
+
+    #[test]
+    fn mutual_members_can_share_a_completed_check_across_workers() -> Result<(), Box<dyn std::error::Error>> {
+        crate::tests::util::test_export_file(
+            Some(std::path::Path::new("test_resources/MutualReceipt/config.json")),
+            |export| {
+                let blocks = export.block_receipts();
+                assert_eq!(blocks.len(), 1);
+                let members: Vec<_> = export.declars.iter().enumerate().filter_map(|(index, (_, d))| {
+                    match d {
+                        Declar::Inductive(ind) if ind.all_ind_names.len() == 2 => Some(index),
+                        _ => None,
+                    }
+                }).collect();
+                assert_eq!(members.len(), 2);
+                let barrier = std::sync::Barrier::new(2);
+                std::thread::scope(|scope| {
+                    for index in members {
+                        let blocks = &blocks;
+                        let barrier = &barrier;
+                        scope.spawn(move || {
+                            barrier.wait();
+                            export.run_session((index, index + 1), || None, blocks);
+                        });
+                    }
+                });
+                assert!(blocks.values().all(|receipt| receipt.done.get().is_some()));
+            },
+        )
+    }
