+#[test]
+fn mutual_block_receipt_is_revoked_between_validation_runs() -> Result<(), Box<dyn Error>> {
+    let config = test_config(Some(Path::new("test_resources/MutualReceipt/config.json")))?;
+    let arena = Arena::new();
+    let (mut export, _) = config.to_export_file(arena.as_arena_ref())?;
+    let constructor = export.declars.values().find_map(|d| match d {
+        crate::env::Declar::Inductive(ind) if ind.all_ind_names.len() == 2 => {
+            let second = ind.all_ind_names[1];
+            let crate::env::Declar::Inductive(other) = export.declars.get(&second).unwrap() else { unreachable!() };
+            Some(other.all_ctor_names[0])
+        }
+        _ => None,
+    }).expect("two-member fixture missing");
+    export.check_all_declars();
+    let crate::env::Declar::Constructor(ctor) = export.declars.get_mut(&constructor).unwrap() else { unreachable!() };
+    ctor.num_fields += 1;
+    export.config.num_threads = 2;
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| export.check_all_declars()));
+    assert!(result.is_err(), "a receipt survived source mutation and admitted a forged constructor");
+    Ok(())
+}
