+#[test]
+fn unused_lambda_argument_is_not_forced() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let prop = tc.ctx.prop();
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let domain = tc.ctx.mk_sort(one);
+        let function = tc.ctx.mk_lambda(domain, prop);
+        let argument = tc.ctx.mk_var(0);
+        let application = tc.ctx.mk_app(function, argument);
+        let delayed = crate::value::mk_thunk(tc.arena, tc.empty_env(), prop);
+        let env = tc.env_extend(tc.empty_env(), delayed);
+        let result = tc.eval(1, env, application);
+        assert!(matches!(result, crate::value::Value::Sort { level, .. } if *level == tc.ctx.zero()));
+        match delayed {
+            crate::value::Value::Thunk { forced, .. } => assert!(forced.get().is_none(), "unused argument was evaluated"),
+            _ => unreachable!(),
+        }
+    }))
+}
