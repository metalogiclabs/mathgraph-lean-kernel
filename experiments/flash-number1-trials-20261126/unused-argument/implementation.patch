+#[test]
+fn lambda_argument_used_in_nested_binder_type_is_forced() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let prop = tc.ctx.prop();
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let domain = tc.ctx.mk_sort(one);
+        let variable = tc.ctx.mk_var(0);
+        let dependent_body = tc.ctx.mk_lambda(variable, variable);
+        let function = tc.ctx.mk_lambda(domain, dependent_body);
+        let application = tc.ctx.mk_app(function, variable);
+        let delayed = crate::value::mk_thunk(tc.arena, tc.empty_env(), prop);
+        let env = tc.env_extend(tc.empty_env(), delayed);
+        let result = tc.eval(1, env, application);
+        assert!(matches!(result, crate::value::Value::Lam { .. }));
+        match delayed {
+            crate::value::Value::Thunk { forced, .. } => assert!(forced.get().is_some(), "binder type lost its argument"),
+            _ => unreachable!(),
+        }
+    }))
+}
