+#[test]
+fn fresh_variables_share_exact_sort_levels_across_value_allocations() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let level = tc.ctx.succ(tc.ctx.zero());
+        let a = crate::value::mk_sort(tc.arena, level);
+        let b = crate::value::mk_sort(tc.arena, level);
+        assert!(!std::ptr::eq(a, b));
+        let x = tc.mk_bvar_hc(0, a);
+        let y = tc.mk_bvar_hc(0, b);
+        assert!(std::ptr::eq(x, y));
+        let inferred = tc.value_type(0, x);
+        assert!(tc.conv_types_at(0, inferred, a));
+    }))
+}
