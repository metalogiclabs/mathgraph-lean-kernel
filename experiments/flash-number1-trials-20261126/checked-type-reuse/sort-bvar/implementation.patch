+#[test]
+fn fresh_variables_keep_universe_and_non_sort_type_distinctions() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let zero = tc.ctx.zero();
+        let one = tc.ctx.succ(zero);
+        let prop = crate::value::mk_sort(tc.arena, zero);
+        let universe = crate::value::mk_sort(tc.arena, one);
+        let p = tc.mk_bvar_hc(0, prop);
+        let a = tc.mk_bvar_hc(0, universe);
+        assert!(!std::ptr::eq(p, a));
+        let b = tc.mk_bvar_hc(1, universe);
+        let x = tc.mk_bvar_hc(2, a);
+        let y = tc.mk_bvar_hc(2, b);
+        assert!(!std::ptr::eq(x, y));
+    }))
+}
