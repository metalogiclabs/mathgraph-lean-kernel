+#[test]
+fn input_expression_sharing_ignores_only_erased_binder_metadata() -> Result<(), Box<dyn Error>> {
+    test_export_file(Some(Path::new("test_resources/SemanticExprSharing/config.json")), |export| {
+        let values: Vec<_> = export.declars.values().map(|d| match d {
+            crate::env::Declar::Definition { val, .. } => *val,
+            _ => panic!(),
+        }).collect();
+        assert_eq!(values.len(), 3);
+        assert_eq!(values[0], values[1]);
+        assert_ne!(values[0], values[2]); // a different domain must stay distinct
+        for d in export.declars.values() { export.check_declar(d); }
+    })
+}
+
+#[test]
+#[should_panic(expected = "def_eq failed")]
+fn input_expression_sharing_does_not_erase_changed_lambda_domains() {
+    test_export_file_should_panic(Some(Path::new("test_resources/SemanticExprSharing/config.json")), |export| {
+        let first = export.declars.get_index(0).unwrap().1;
+        let third = export.declars.get_index(2).unwrap().1;
+        let crate::env::Declar::Definition { val, hint, info } = third else { panic!() };
+        let bad = crate::env::Declar::Definition {
+            val: *val, hint: *hint,
+            info: crate::env::DeclarInfo { ty: first.info().ty, ..*info },
+        };
+        export.with_tc(crate::env::EnvLimit::ByIndex(2), |tc| {
+            tc.declar_info = Some(*bad.info());
+            tc.check_def_like_v(&bad, *val);
+        });
+    });
+}
