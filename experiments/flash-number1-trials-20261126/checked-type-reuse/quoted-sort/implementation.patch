+#[test]
+fn quoted_type_uses_semantic_levels_across_let_aliases() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        quoted_type_test_scope(tc);
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let kind = crate::value::mk_sort(tc.arena, one);
+        let a = tc.mk_bvar_hc(0, kind);
+        let first = tc.env_extend(tc.empty_env(), a);
+        let env = tc.env_extend(first, a); // a source let alias adds no fresh level
+        let c1 = crate::value::ctx_extend(tc.arena, tc.empty_ctx(), kind);
+        let ctx = crate::value::ctx_extend(tc.arena, c1, kind);
+        let var0 = tc.ctx.mk_var(0);
+        let term = tc.ctx.mk_lambda(var0, var0);
+        let ty = tc.infer_value(crate::tc::InferFlag::Check, 1, env, ctx, term);
+        let crate::value::Value::Pi { body, .. } = ty else { panic!() };
+        let x = tc.mk_bvar_hc(1, a);
+        assert!(std::ptr::eq(tc.apply_closure(2, body, x, None), a));
+    }))
+}
