+use crate::value::{Closure, ElimView, RigidHead, Spine, Value, E, S, V};
 
 impl<'x, 't, 'p> TypeChecker<'x, 't, 'p> {
+    // Keep a checked type family as an expression, rather than re-inferring
+    // its proof body for every later argument. Quotation uses semantic levels;
+    // its capture environment must therefore use levels too, independently of
+    // source let-bindings and the support of the original proof expression.
+    pub(crate) fn checked_type_closure(&mut self, cutoff: u32, result: V<'t>, fresh: V<'t>) -> Option<Closure<'t>> {
+        if cutoff > 63 || self.env.has_temp_ext() || self.declar_info.is_none() {
+            return None;
+        }
+        let mut captures = [None; 64];
+        if !self.type_quote_captures(cutoff + 1, cutoff, result, &mut captures, &mut 512) {
+            return None;
+        }
+        let source = self.quote(cutoff + 1, result);
+        if source.num_loose_bvars() > 64 || u32::from(source.num_loose_bvars()) > cutoff + 1 {
+            return None;
+        }
+        let mut mask = 0u64;
+        let mut hash = 0u64;
+        let mut slots = smallvec::SmallVec::<[V<'t>; 16]>::new();
+        for index in 0..cutoff {
+            if let Some(value) = captures[(cutoff - 1 - index) as usize] {
+                mask |= 1u64 << index;
+                hash = hash.wrapping_mul(0x9E3779B97F4A7C15)
+                    .wrapping_add(value as *const Value<'t> as usize as u64);
+                slots.push(value);
+            }
+        }
+        // Bit zero is the abstracted argument. Every other free variable
+        // must have an explicit capture; never fill a missing slot by guess.
+        if source.as_ref().fv_mask() & !((mask << 1) | 1) != 0 {
+            return None;
+        }
+        let env = if mask == 0 { self.empty_env() } else {
+            let hash = mask.wrapping_mul(0x9E3779B97F4A7C15).wrapping_add(hash);
+            self.intern_frame(hash, mask, &slots, None)
+        };
+        let replay_env = self.env_extend(env, fresh);
+        let replayed = self.eval(cutoff + 1, replay_env, source);
+        // The argument is an arbitrary fresh variable, not a sampled value.
+        // Conversion under it validates this reification before admission.
+        if !self.conv_types_at(cutoff + 1, result, replayed) {
+            return None;
+        }
+        Some(Closure::mk_eval(env, source))
+    }
+
+    fn type_quote_captures(
+        &mut self,
+        depth: u32,
+        cutoff: u32,
+        value: V<'t>,
+        captures: &mut [Option<V<'t>>; 64],
+        fuel: &mut usize,
+    ) -> bool {
+        if *fuel == 0 { return false; }
+        *fuel -= 1;
+        let value = self.force_thunk(depth, value);
+        let mut spine = match value {
+            Value::Sort { .. } | Value::NatLit { .. } | Value::StrLit { .. } => return true,
+            Value::Rigid { head, spine, .. } => {
+                if let RigidHead::BVar(level, ty) = *head {
+                    if level >= depth { return false; }
+                    if level < cutoff {
+                        let head = self.mk_bvar_hc(level, ty);
+                        let slot = &mut captures[level as usize];
+                        if slot.is_some_and(|old| !std::ptr::eq(old, head)) { return false; }
+                        *slot = Some(head);
+                    }
+                }
+                *spine
+            }
+            Value::Unfold { spine, .. } => *spine,
+            Value::Lam { body, .. } => {
+                let domain = self.lam_domain(depth, value);
+                let fresh = self.mk_bvar_hc(depth, domain);
+                let body = self.apply_closure(depth + 1, body, fresh, None);
+                return self.type_quote_captures(depth, cutoff, domain, captures, fuel)
+                    && self.type_quote_captures(depth + 1, cutoff, body, captures, fuel);
+            }
+            Value::Pi { domain, body, .. } => {
+                let fresh = self.mk_bvar_hc(depth, domain);
+                let body = self.apply_closure(depth + 1, body, fresh, Some(domain));
+                return self.type_quote_captures(depth, cutoff, domain, captures, fuel)
+                    && self.type_quote_captures(depth + 1, cutoff, body, captures, fuel);
+            }
+            Value::Thunk { .. } => unreachable!("type capture: thunk after force"),
+        };
+        while let Spine::Snoc { prev, elim, .. } = spine {
+            if *fuel == 0 { return false; }
+            *fuel -= 1;
+            if let ElimView::App(arg) = elim.view() {
+                if !self.type_quote_captures(depth, cutoff, arg, captures, fuel) { return false; }
+            }
+            spine = prev;
+        }
+        true
+    }
