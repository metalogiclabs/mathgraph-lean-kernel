+#[test]
+fn quoted_dependent_lambda_type_substitutes_distinct_arguments() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        quoted_type_test_scope(tc);
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let universe = tc.ctx.mk_sort(one);
+        let var0 = tc.ctx.mk_var(0);
+        let inner = tc.ctx.mk_lambda(var0, var0);
+        let term = tc.ctx.mk_lambda(universe, inner);
+        let ty = tc.infer_value(crate::tc::InferFlag::Check, 0, tc.empty_env(), tc.empty_ctx(), term);
+        let crate::value::Value::Pi { body, .. } = ty else { panic!() };
+        let prop = tc.ctx.prop();
+        let fn_type = tc.ctx.mk_pi(prop, prop);
+        let a = tc.eval(0, tc.empty_env(), prop);
+        let b = tc.eval(0, tc.empty_env(), fn_type);
+        for actual in [a, b] {
+            // No inference context or binder type is needed for the retained
+            // type family. These are different well-typed Type arguments.
+            let result = tc.apply_closure(0, body, actual, None);
+            let crate::value::Value::Pi { domain, body, .. } = result else { panic!() };
+            assert!(tc.conv_types_at(0, domain, actual));
+            let argument = tc.mk_bvar_hc(4, domain);
+            let final_type = tc.apply_closure(5, body, argument, None);
+            assert!(tc.conv_types_at(5, final_type, actual));
+        }
+    }))
+}
