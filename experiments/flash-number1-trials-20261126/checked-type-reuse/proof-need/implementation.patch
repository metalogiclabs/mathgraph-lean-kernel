+#[test]
+fn known_proof_arguments_remain_suspended_after_source_checking() -> Result<(), Box<dyn Error>> {
+    test_export_file(Some(Path::new("test_resources/ProofIrrelUnderBVar/config.json")), |export| {
+        export.with_tc(crate::env::EnvLimit::ByIndex(export.declars.len()), |tc| {
+            let levels = tc.ctx.alloc_levels_slice(&[]);
+            let an = tc.ctx.str1("A"); let pn = tc.ctx.str1("P");
+            let qn = tc.ctx.str1("Q"); let avn = tc.ctx.str1("a");
+            let a = tc.ctx.mk_const(an, levels); let p = tc.ctx.mk_const(pn, levels);
+            let q = tc.ctx.mk_const(qn, levels); let av = tc.ctx.mk_const(avn, levels);
+            let hty = tc.ctx.mk_pi(a, p);
+            let hty = tc.eval(0, tc.empty_env(), hty);
+            let h = tc.mk_bvar_hc(0, hty);
+            let env = tc.env_extend(tc.empty_env(), h);
+            let ctx = crate::value::ctx_extend(tc.arena, tc.empty_ctx(), hty);
+            let var0 = tc.ctx.mk_var(0);
+            let argument = tc.ctx.mk_app(var0, av);
+            let expression = tc.ctx.mk_app(q, argument);
+            tc.infer_value(crate::tc::InferFlag::Check, 1, env, ctx, expression);
+            let result = tc.eval(1, env, expression);
+            let crate::value::Value::Rigid { spine: crate::value::Spine::Snoc { elim, .. }, .. } = result else { panic!() };
+            let crate::value::ElimView::App(argument) = elim.view() else { panic!() };
+            assert!(matches!(argument, crate::value::Value::Thunk { forced, .. } if forced.get().is_none()));
+            assert!(!matches!(tc.force_thunk(1, argument), crate::value::Value::Thunk { .. }));
+        })
+    })
+}
