+#[cfg(test)]
+mod call_by_need_tests {
+    use crate::tests::util::test_export_file;
+    use crate::value::{self, Value};
+    use std::error::Error;
+
+    #[test]
+    fn forced_thunk_chains_reach_the_actual_head() -> Result<(), Box<dyn Error>> {
+        test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+            let prop = tc.ctx.prop();
+            let head = value::mk_sort(tc.arena, tc.ctx.zero());
+            let mut previous = head;
+            for _ in 0..10_000 {
+                let next = value::mk_thunk(tc.arena, tc.empty_env(), prop);
+                let Value::Thunk { forced, .. } = next else { unreachable!() };
+                forced.set(previous).unwrap();
+                previous = next;
+            }
+            assert!(std::ptr::eq(tc.force_thunk(0, previous), head));
+        }))
+    }
+
+    #[test]
+    fn delayed_arguments_capture_values_and_share_only_exact_keys() -> Result<(), Box<dyn Error>> {
+        test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+            let prop = tc.ctx.prop();
+            let variable = tc.ctx.mk_var(0);
+            let identity = tc.ctx.mk_lambda(prop, variable);
+            let expression = tc.ctx.mk_app(identity, variable);
+            let one = tc.ctx.succ(tc.ctx.zero());
+            let v0 = value::mk_sort(tc.arena, tc.ctx.zero());
+            let v1 = value::mk_sort(tc.arena, one);
+            let env0 = tc.env_extend(tc.empty_env(), v0);
+            let env1 = tc.env_extend(tc.empty_env(), v1);
+            let a = tc.delay_arg(1, env0, expression);
+            assert!(matches!(a, Value::Thunk { forced, .. } if forced.get().is_none()));
+            assert!(std::ptr::eq(a, tc.delay_arg(1, env0, expression)));
+            let b = tc.delay_arg(1, env1, expression);
+            assert!(!std::ptr::eq(a, b));
+            assert!(std::ptr::eq(tc.force_thunk(1, a), v0));
+            assert!(std::ptr::eq(tc.force_thunk(1, b), v1));
+            assert!(std::ptr::eq(tc.delay_arg(1, env0, expression), v0));
+            tc.tc_cache.clear();
+            assert!(tc.tc_cache.thunk_hc.is_empty());
+            let fresh = tc.delay_arg(1, env0, expression);
+            assert!(!std::ptr::eq(a, fresh));
+            assert!(std::ptr::eq(tc.force_thunk(1, fresh), v0));
+        }))
+    }
+
+    #[test]
+    fn delayed_arguments_preserve_universe_substitutions() -> Result<(), Box<dyn Error>> {
+        test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+            let u = tc.ctx.param_quick("u");
+            let zero = tc.ctx.zero();
+            let one = tc.ctx.succ(zero);
+            let sort_u = tc.ctx.mk_sort(u);
+            let variable = tc.ctx.mk_var(0);
+            let identity = tc.ctx.mk_lambda(sort_u, variable);
+            let expression = tc.ctx.mk_app(identity, sort_u);
+            let ks = tc.ctx.alloc_levels_slice(&[u]);
+            let vs0 = tc.ctx.alloc_levels_slice(&[zero]);
+            let vs1 = tc.ctx.alloc_levels_slice(&[one]);
+            let ls0 = tc.arena.alloc(value::LevelSub { ks, vs: vs0 });
+            let ls1 = tc.arena.alloc(value::LevelSub { ks, vs: vs1 });
+            let env0 = tc.lsub_base(Some(ls0));
+            let env1 = tc.lsub_base(Some(ls1));
+            let a = tc.delay_arg(0, env0, expression);
+            let b = tc.delay_arg(0, env1, expression);
+            assert!(!std::ptr::eq(a, b));
+            assert!(matches!(tc.force_thunk(0, a), Value::Sort { level, .. } if *level == zero));
+            assert!(matches!(tc.force_thunk(0, b), Value::Sort { level, .. } if *level == one));
+        }))
+    }
