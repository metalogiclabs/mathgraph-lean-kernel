+//! Substitute an argument in a previously checked semantic result type.
+//! This is optional reuse: unsupported values and exhausted work fall back to
+//! ordinary inference of the original body. No source checks are omitted.
+use crate::tc::TypeChecker;
+use crate::util::{new_fx_hash_map, FxHashMap};
+use crate::value::{self, Closure, Ctx, ElimView, Env, RigidHead, Spine, Value, C, E, V};
+
+struct Substitution<'a> {
+    binder: V<'a>,
+    level: u32,
+    argument: V<'a>,
+    remaining: usize,
+    values: FxHashMap<usize, V<'a>>,
+}
+
+impl Substitution<'_> {
+    fn step(&mut self) -> Option<()> {
+        self.remaining = self.remaining.checked_sub(1)?;
+        Some(())
+    }
+}
+
+impl<'x, 't, 'p> TypeChecker<'x, 't, 'p> {
+    pub(crate) fn substitute_checked_type(
+        &mut self, depth: u32, result: V<'t>, binder: V<'t>, argument: V<'t>,
+    ) -> Option<V<'t>> {
+        let Value::Rigid { head: RigidHead::BVar(level, _), spine: Spine::Empty, .. } = binder else {
+            return None;
+        };
+        let mut substitution = Substitution {
+            binder, level: *level, argument, remaining: 256, values: new_fx_hash_map(),
+        };
+        self.subst_checked_value(depth, result, &mut substitution)
+    }
+
+    fn subst_checked_value(&mut self, depth: u32, v: V<'t>, s: &mut Substitution<'t>) -> Option<V<'t>> {
+        s.step()?;
+        if std::ptr::eq(v, s.binder) {
+            return Some(s.argument);
+        }
+        // Do not use the value digest's closed flag here. An evaluation
+        // lambda can mention a variable only in its binder annotation; its
+        // body support alone does not authorize skipping this substitution.
+        if matches!(v, Value::Sort { .. } | Value::NatLit { .. } | Value::StrLit { .. }) {
+            return Some(v);
+        }
+        match v {
+            Value::Rigid { head: RigidHead::BVar(level, _), spine: Spine::Empty, .. } if *level < s.level =>
+                return Some(v),
+            Value::Rigid { head: RigidHead::BVar(..), .. } => {},
+            Value::Rigid { spine: Spine::Empty, .. } | Value::Unfold { spine: Spine::Empty, .. } =>
+                return Some(v),
+            _ => {},
+        }
+        let key = v as *const Value<'t> as usize;
+        if let Some(r) = s.values.get(&key) {
+            return Some(*r);
+        }
+        let r = match v {
+            Value::Sort { .. } | Value::NatLit { .. } | Value::StrLit { .. } => v,
+            Value::Thunk { .. } => return None,
+            Value::Lam { binder_type, body, .. } => {
+                let b = self.subst_checked_closure(depth, body, s)?;
+                if std::ptr::eq(body.env, b.env) && same_context(body.ctx, b.ctx) {
+                    v
+                } else {
+                    value::mk_lam(self.arena, *binder_type, b)
+                }
+            }
+            Value::Pi { domain, body, .. } => {
+                let d = self.subst_checked_value(depth, domain, s)?;
+                let b = self.subst_checked_closure(depth, body, s)?;
+                if std::ptr::eq(*domain, d) && std::ptr::eq(body.env, b.env) && same_context(body.ctx, b.ctx) {
+                    v
+                } else {
+                    value::mk_pi(self.arena, d, b)
+                }
+            }
+            Value::Rigid { head, spine, .. } => {
+                let replacement = match *head {
+                    RigidHead::BVar(level, ty) => {
+                        // Equal numeric levels from another context are not
+                        // evidence of identity. A mismatch abandons this reuse.
+                        if level >= s.level {
+                            let Value::Rigid { head: RigidHead::BVar(_, binder_ty), .. } = s.binder else {
+                                unreachable!()
+                            };
+                            if level != s.level || !std::ptr::eq(ty, *binder_ty) { return None; }
+                            Some(s.argument)
+                        } else {
+                            None
+                        }
+                    }
+                    _ => None,
+                };
+                self.subst_checked_spine(depth, v, replacement, spine, s)?
+            }
+            Value::Unfold { spine, .. } => {
+                self.subst_checked_spine(depth, v, None, spine, s)?
+            }
+        };
+        s.values.insert(key, r);
+        Some(r)
+    }
+
+    fn subst_checked_spine(
+        &mut self, depth: u32, original: V<'t>, replacement: Option<V<'t>>, spine: value::S<'t>, s: &mut Substitution<'t>,
+    ) -> Option<V<'t>> {
+        let mut reversed = smallvec::SmallVec::<[value::Elim<'t>; 8]>::new();
+        let mut cur = spine;
+        let mut changed = replacement.is_some();
+        while let Spine::Snoc { prev, elim, .. } = cur {
+            s.step()?;
+            reversed.push(*elim);
+            cur = prev;
+        }
+        let mut forward = smallvec::SmallVec::<[value::Elim<'t>; 8]>::new();
+        while let Some(elim) = reversed.pop() {
+            let e = match elim.view() {
+                ElimView::App(a) => {
+                    let b = self.subst_checked_value(depth, a, s)?;
+                    changed |= !std::ptr::eq(a, b);
+                    value::Elim::app(b)
+                }
+                ElimView::Proj { .. } => elim,
+            };
+            forward.push(e);
+        }
+        if !changed { return Some(original); }
+        let empty = self.empty_spine();
+        let mut result = match replacement {
+            Some(v) => v,
+            None => match original {
+                Value::Rigid { head, .. } => value::mk_rigid(self.arena, *head, empty),
+                Value::Unfold { head, head_value, .. } =>
+                    value::mk_unfold(self.arena, head.name, head.levels, empty, head_value),
+                _ => unreachable!(),
+            },
+        };
+        for elim in forward {
+            result = match elim.view() {
+                ElimView::App(a) => self.apply(depth, result, a),
+                ElimView::Proj { ty_name, idx } => self.do_proj(depth, ty_name, idx, result),
+            };
+        }
+        Some(result)
+    }
+
+    fn subst_checked_closure(
+        &mut self, depth: u32, body: &Closure<'t>, s: &mut Substitution<'t>,
+    ) -> Option<Closure<'t>> {
+        let env = self.subst_checked_env(depth, body.env, s)?;
+        let ctx = match body.ctx {
+            Some(c) => Some(self.subst_checked_ctx(depth, c, s)?),
+            None => None,
+        };
+        Some(Closure { env, ctx, body: body.body })
+    }
+
+    fn subst_checked_env(&mut self, depth: u32, env: E<'t>, s: &mut Substitution<'t>) -> Option<E<'t>> {
+        s.step()?;
+        match env {
+            Env::Nil { .. } => Some(env),
+            Env::Cons { v, parent, .. } => {
+                let a = self.subst_checked_value(depth, v, s)?;
+                let p = self.subst_checked_env(depth, parent, s)?;
+                Some(if std::ptr::eq(*v, a) && std::ptr::eq(*parent, p) { env } else { self.env_extend(p, a) })
+            }
+            Env::Framed { mask, slots, lsub, .. } => {
+                let mut changed = false;
+                let mut hash = lsub.map_or(0, |l| l as *const value::LevelSub<'t> as usize as u64);
+                let mut result = smallvec::SmallVec::<[V<'t>; 16]>::new();
+                for a in *slots {
+                    let b = self.subst_checked_value(depth, a, s)?;
+                    changed |= !std::ptr::eq(*a, b);
+                    hash = hash.wrapping_mul(0x9E3779B97F4A7C15).wrapping_add(b as *const Value<'t> as usize as u64);
+                    result.push(b);
+                }
+                let hash = mask.wrapping_mul(0x9E3779B97F4A7C15).wrapping_add(hash);
+                Some(if changed { self.intern_frame(hash, *mask, &result, *lsub) } else { env })
+            }
+            Env::WideFramed { .. } => None,
+        }
+    }
+
+    fn subst_checked_ctx(&mut self, depth: u32, ctx: C<'t>, s: &mut Substitution<'t>) -> Option<C<'t>> {
+        s.step()?;
+        match ctx {
+            Ctx::Nil => Some(ctx),
+            Ctx::Cons { ty, parent } => {
+                let t = self.subst_checked_value(depth, ty, s)?;
+                let p = self.subst_checked_ctx(depth, parent, s)?;
+                Some(if std::ptr::eq(*ty, t) && std::ptr::eq(*parent, p) { ctx } else {
+                    value::ctx_extend(self.arena, p, t)
+                })
+            }
+            Ctx::InferredResult { result, binder: None, context } => {
+                let r = self.subst_checked_value(depth, result, s)?;
+                let c = self.subst_checked_ctx(depth, context, s)?;
+                Some(if std::ptr::eq(*result, r) && std::ptr::eq(*context, c) { ctx } else {
+                    self.arena.alloc(Ctx::InferredResult { result: r, binder: None, context: c })
+                })
+            }
+            // A nested retained result has its own fresh binder. Discard that
+            // optional record, preserving the original inference context and
+            // body, rather than guessing how to rename its private binder.
+            Ctx::InferredResult { context, .. } => self.subst_checked_ctx(depth, context, s),
+        }
+    }
+}
+
+fn same_context<'a>(a: Option<C<'a>>, b: Option<C<'a>>) -> bool {
+    match (a, b) {
+        (None, None) => true,
+        (Some(a), Some(b)) => std::ptr::eq(a, b),
+        _ => false,
+    }
+}
+
