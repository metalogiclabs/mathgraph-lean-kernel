+#[test]
+fn substituted_type_captures_variables_visible_only_in_the_result_type() -> Result<(), Box<dyn Error>> {
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        substituted_type_test_scope(tc);
+        let one = tc.ctx.succ(tc.ctx.zero());
+        let two = tc.ctx.succ(one);
+        let universe = tc.ctx.mk_sort(one);
+        let var1 = tc.ctx.mk_var(1);
+        let term = tc.ctx.mk_lambda(universe, var1);
+        let dom = tc.eval(0, tc.empty_env(), universe);
+        let argument_expr = tc.ctx.prop();
+        let argument = tc.eval(0, tc.empty_env(), argument_expr);
+        for sort in [one, two] {
+            let kind = crate::value::mk_sort(tc.arena, sort);
+            let a = tc.mk_bvar_hc(0, kind);
+            let x = tc.mk_bvar_hc(1, a);
+            let first = tc.env_extend(tc.empty_env(), a);
+            let full = tc.env_extend(first, x);
+            let env = tc.key_env(full, term);
+            // The term reads x; its inferred result type reads A. A is absent
+            // from the source expression's pruned evaluation environment.
+            assert!(env.lookup(1).is_none());
+            let c1 = crate::value::ctx_extend(tc.arena, tc.empty_ctx(), kind);
+            let ctx = crate::value::ctx_extend(tc.arena, c1, a);
+            let ty = tc.infer_value(crate::tc::InferFlag::Check, 2, env, ctx, term);
+            let crate::value::Value::Pi { domain, body, .. } = ty else { panic!() };
+            assert!(tc.conv_types_at(2, domain, dom));
+            let result = tc.apply_closure(2, body, argument, None);
+            // Pointer identity also detects cross-context reuse at the same
+            // numeric level with a different variable type.
+            assert!(std::ptr::eq(result, a));
+        }
+    }))
+}
