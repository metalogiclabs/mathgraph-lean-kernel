+        export.with_tc(crate::env::EnvLimit::ByIndex(1), |tc| {
+            tc.declar_info = Some(*info);
+            tc.check_def_like_v(d, *val);
+            tc.tc_cache.clear();
+            let prop = tc.ctx.prop();
+            let wrong = tc.ctx.mk_pi(prop, prop);
+            let bad = crate::env::Declar::Definition {
+                info: crate::env::DeclarInfo { ty: wrong, ..*info }, val: *val, hint: *hint,
+            };
+            tc.check_def_like_v(&bad, *val);
+        });
+    });
+}
