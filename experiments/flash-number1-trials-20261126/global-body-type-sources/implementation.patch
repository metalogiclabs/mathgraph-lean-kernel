+    test_export_file(Some(Path::new(CLOSED_FACT_CONFIG)), |export| {
+        let info = *export.declars.get_index(1).unwrap().1.info();
+        export.with_tc(crate::env::EnvLimit::ByIndex(1), |tc| {
+            tc.declar_info = Some(info);
+            let prop = tc.ctx.prop();
+            let var0 = tc.ctx.mk_var(0);
+            let term = tc.ctx.mk_lambda(prop, var0);
+            assert!(term.is_local());
+            tc.infer_value(crate::tc::InferFlag::Check, 0, tc.empty_env(), tc.empty_ctx(), term);
+            assert!(tc.ctx.checked_closed.is_empty());
+        });
+    })
+}
