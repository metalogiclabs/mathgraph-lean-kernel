+const CLOSED_FACT_CONFIG: &str = "test_resources/ClosedCheckFacts/config.json";
+
+#[test]
+fn closed_check_facts_survive_value_cache_reset() -> Result<(), Box<dyn Error>> {
+    test_export_file(Some(Path::new(CLOSED_FACT_CONFIG)), |export| {
+        let d = export.declars.get_index(1).unwrap().1;
+        let crate::env::Declar::Definition { val, info, .. } = d else { panic!() };
+        export.with_tc(crate::env::EnvLimit::ByIndex(1), |tc| {
+            tc.declar_info = Some(*info);
+            tc.check_def_like_v(d, *val);
+            assert_eq!(tc.ctx.checked_closed_sources.get(&(*val, info.uparams)), Some(&(info.ty, 1)));
+            let first = tc.infer_value(crate::tc::InferFlag::Check, 0, tc.empty_env(), tc.empty_ctx(), *val);
+            assert_eq!(tc.ctx.checked_closed.get(&(*val, info.uparams)), Some(&1));
+            tc.tc_cache.clear();
+            let second = tc.infer_value(crate::tc::InferFlag::Check, 0, tc.empty_env(), tc.empty_ctx(), *val);
+            assert!(tc.conv_types_at(0, first, second));
+        });
+    })
+}
