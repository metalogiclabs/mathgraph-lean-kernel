+                tc.infer_value(crate::tc::InferFlag::Check, 0, tc.empty_env(), tc.empty_ctx(), *val);
+                tc.tc_cache.clear();
+            }
+            let prop = ctx.prop();
+            let mut ext = crate::util::new_fx_index_map();
+            ext.insert(first.name, crate::env::Declar::Axiom {
