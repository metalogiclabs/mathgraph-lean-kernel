+++ b/src/util.rs
@@ -1041,6 +1041,59 @@ pub struct NameCache<'p> {
 pub(crate) const PRUNE_DM_LEN: usize = 1 << 10;
 pub(crate) const PRUNE_DM_SHIFT: u32 = 64 - 10;
 
+/// A bounded exact-key memo for support projections with more than 64 binders.
+/// Collisions evict an entry and cause ordinary recomputation. An environment
+/// address or expression alone never authorizes reuse. The entire memo is
+/// invalidated at the same namespace and allocation-lifetime barriers as before.
+pub(crate) struct WidePruneMemo<'a, 't> {
+    slots: Box<[(usize, Option<ExprPtr<'t>>, Option<E<'a>>)]>,
+    touched: Vec<usize>,
+}
+
+impl<'a, 't> WidePruneMemo<'a, 't> {
+    const BITS: u32 = 14;
+
+    pub(crate) fn new() -> Self {
+        Self {
+            slots: vec![(0, None, None); 1 << Self::BITS].into_boxed_slice(),
+            touched: Vec::new(),
+        }
+    }
+
+    #[inline]
+    fn slot(key: &(usize, ExprPtr<'t>)) -> usize {
+        let address = key.1.as_ref() as *const Expr<'t> as usize as u64;
+        let mixed = (key.0 as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15)
+            ^ address.wrapping_mul(0xD6E8_FEB8_6659_FD93);
+        (mixed >> (64 - Self::BITS)) as usize
+    }
+
+    #[inline]
+    pub(crate) fn get(&self, key: &(usize, ExprPtr<'t>)) -> Option<E<'a>> {
+        let entry = self.slots[Self::slot(key)];
+        if entry.0 == key.0 && entry.1 == Some(key.1) {
+            entry.2
+        } else {
+            None
+        }
+    }
+
+    #[inline]
+    pub(crate) fn insert(&mut self, key: (usize, ExprPtr<'t>), result: E<'a>) {
+        let index = Self::slot(&key);
+        if self.slots[index].2.is_none() {
+            self.touched.push(index);
+        }
+        self.slots[index] = (key.0, Some(key.1), Some(result));
+    }
+
+    pub(crate) fn clear(&mut self) {
+        for index in self.touched.drain(..) {
+            self.slots[index] = (0, None, None);
+        }
+    }
+}
