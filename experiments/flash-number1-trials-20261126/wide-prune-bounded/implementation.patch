+#[test]
+fn wide_prune_memo_requires_both_keys_and_clears_evictions() -> Result<(), Box<dyn Error>> {
+    test_ctx(None, |ctx| {
+        let e0 = ctx.mk_var(0);
+        let e1 = ctx.mk_var(1);
+        let arena = bumpalo::Bump::new();
+        let first = crate::value::env_empty(&arena);
+        let second = crate::value::env_empty(&arena);
+        let mut memo = crate::util::WidePruneMemo::new();
+        memo.insert((1, e0), first);
+        assert!(std::ptr::eq(memo.get(&(1, e0)).unwrap(), first));
+        assert!(memo.get(&(1, e1)).is_none());
+        assert!(memo.get(&(2, e0)).is_none());
+        // More keys than slots force actual collisions. Every returned value
+        // must belong to its complete key; eviction may only produce a miss.
+        for key in 1..=40_000 {
+            memo.insert((key, e0), if key % 2 == 0 { first } else { second });
+        }
+        let mut hits = 0;
+        for key in 1..=40_000 {
+            if let Some(result) = memo.get(&(key, e0)) {
+                hits += 1;
+                assert!(std::ptr::eq(result, if key % 2 == 0 { first } else { second }));
+            }
+            assert!(memo.get(&(key, e1)).is_none());
+        }
+        assert!(hits > 0 && hits < 40_000);
+        memo.clear();
+        for key in 1..=40_000 {
+            assert!(memo.get(&(key, e0)).is_none());
+        }
+        memo.insert((1, e1), second);
+        assert!(memo.get(&(1, e0)).is_none());
+        assert!(std::ptr::eq(memo.get(&(1, e1)).unwrap(), second));
+    })
+}
