+    #[cfg(feature = "declaration-costs")]
+    fn report_declaration_costs(&self) {
+        let mut rows = std::mem::take(&mut *DECLARATION_COSTS.lock().unwrap());
+        assert_eq!(rows.len(), self.declars.len(), "incomplete diagnostic census");
+        let mut seen = vec![false; rows.len()];
+        for &(index, _) in &rows {
+            assert!(!seen[index], "duplicate diagnostic declaration");
+            seen[index] = true;
+        }
+        rows.sort_unstable_by_key(|&(_, elapsed)| std::cmp::Reverse(elapsed));
+        let total_ns: u64 = rows.iter().map(|&(_, ns)| ns).sum();
+        let cumulative: Vec<_> = [1usize, 10, 100, 1000, 10000].into_iter().map(|n| {
+            let elapsed_ns: u64 = rows.iter().take(n).map(|&(_, ns)| ns).sum();
+            serde_json::json!({"top_n": n.min(rows.len()), "elapsed_ns": elapsed_ns})
+        }).collect();
+        let top = self.with_ctx(|ctx, _, _| {
+            rows.iter().take(100).map(|&(index, elapsed_ns)| {
+                let (_, d) = self.declars.get_index(index).unwrap();
+                let kind = match d {
+                    Declar::Inductive(..) => "inductive", Declar::Recursor(..) => "recursor",
+                    Declar::Constructor(..) => "constructor", Declar::Definition { .. } => "definition",
+                    Declar::Theorem { .. } => "theorem", Declar::Opaque { .. } => "opaque",
+                    Declar::Axiom { .. } => "axiom", Declar::Quot { .. } => "quotient",
+                };
+                serde_json::json!({"index": index, "name": format!("{:?}", ctx.debug_print(d.info().name)),
+                    "kind": kind, "elapsed_ns": elapsed_ns})
+            }).collect::<Vec<_>>()
+        });
+        eprintln!("FLASH_DECLARATION_COSTS {}", serde_json::json!({
+            "declarations": rows.len(), "threads": self.config.num_threads,
+            "total_declaration_elapsed_ns": total_ns, "cumulative": cumulative, "top": top,
+            "rows": rows,
+            "boundary": "Instrumented per-declaration elapsed time; includes descendants of each check, excludes parsing and session maintenance. Not an Arena instruction score or an uninstrumented timing comparison."
+        }));
     }
