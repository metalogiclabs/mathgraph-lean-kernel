+// Keep structural hashes stable; only table bucket selection uses the newer
+// dependency. Equality checks and all kernel digest construction are unchanged.
+type TableHasher = BuildHasherDefault<rustc_hash_table::FxHasher>;
+pub(crate) type FxIndexMap<K, V> = IndexMap<K, V, TableHasher>;
+pub(crate) type FxHashMap<K, V> = HashMap<K, V, TableHasher>;
+pub(crate) type FxHashSet<K> = HashSet<K, TableHasher>;
 
