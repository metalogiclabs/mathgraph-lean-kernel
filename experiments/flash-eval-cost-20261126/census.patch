+macro_rules! memo_observed {
+    ($map:expr, $key:expr, $compute:expr, $counts:expr, $hit:expr) => {{
+        let key = $key;
+        match $map.find(key) {
+            Ok(v) => { $counts[$hit] += 1; v }
+            Err(at) => {
+                $counts[$hit + 1] += 1;
+                let epoch = $map.epoch();
+                let v = $compute;
+                $map.insert_found(at, epoch, key, v);
+                v
+            }
+        }
+    }};
+}
