+pub(crate) struct EvalCostCensus(pub(crate) [u64; 48]);
+
+impl Default for EvalCostCensus {
+    fn default() -> Self { Self([0; 48]) }
+}
+
+impl Drop for EvalCostCensus {
+    fn drop(&mut self) {
+        eprintln!("EVAL_COST_CENSUS {}", serde_json::json!({"counts": self.0.as_slice()}));
