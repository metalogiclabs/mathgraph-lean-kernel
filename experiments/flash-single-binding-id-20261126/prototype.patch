+    /// The expression ID fixes the selected binding position. The value ID also
+    /// retains the type carried by a bound variable. Universe substitutions use
+    /// the existing canonical-environment path, and no key is an environment ID.
+    #[inline(always)]
+    pub(crate) fn cache_environment(&mut self, env: E, mask: u64) -> (EvalEnvKey, E) {
+        if mask & FAR == 0
+            && mask.count_ones() == 1
+            && self.vals().env_lsub(env).is_none()
+            && let Some(value) = self.vals().env_lookup(env, mask.trailing_zeros() as u16)
+        {
+            return (EvalEnvKey::binding(value), env);
+        }
+        let projected = self.prune_env(env, mask);
+        (EvalEnvKey::environment(projected), projected)
+    }
