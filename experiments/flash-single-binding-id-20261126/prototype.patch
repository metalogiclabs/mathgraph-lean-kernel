+/// A cache identity only; unlike `E`, this can never be used to index an environment.
+#[derive(Clone, Copy, Default, PartialEq, Eq, Debug)]
+pub(crate) struct EvalEnvKey(u32);
+
+impl EvalEnvKey {
+    pub(crate) fn environment(env: E) -> Self {
+        Self(env.raw())
+    }
+
+    pub(crate) fn binding(value: V) -> Self {
+        Self(value.raw() | APP_ACTIVE)
+    }
+
+    pub(crate) fn raw(self) -> u32 {
+        self.0
+    }
+}
