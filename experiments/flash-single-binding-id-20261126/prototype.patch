+#[cfg(test)]
+mod single_binding_tests {
+    use super::*;
+    use crate::checker::env::EnvLimit;
+    use crate::checker::tc::InferFlag;
+    use crate::config::Config;
+    use crate::frontend::parser::parse_export_mapped;
+    use crate::term::id::ZERO;
+    use crate::term::level::Level;
+
+    #[test]
+    fn unused_binding_can_change_but_selected_binding_cannot() {
+        let export = parse_export_mapped(b"{\"ie\":0,\"sort\":0}\n", Config::default()).unwrap();
+        export.with_ctx(|ctx, cache, _| {
+            ctx.with_tc(EnvLimit::ByIndex(0), cache, |tc| {
+                let one = tc.ctx.succ(ZERO);
+                let sort = tc.ctx.mk_sort(ZERO);
+                let outer_under_lambda = tc.ctx.mk_var(1);
+                let lambda = tc.ctx.mk_lambda(sort, outer_under_lambda);
+                let expression = tc.ctx.mk_app(lambda, sort);
+                let zero_value = tc.mk_sort_hc(ZERO);
+                let one_value = tc.mk_sort_hc(one);
+                let dead_a = tc.env_extend(EMPTY_ENV, zero_value);
+                let dead_b = tc.env_extend(EMPTY_ENV, one_value);
+                let env_a = tc.env_extend(dead_a, zero_value);
+                let env_b = tc.env_extend(dead_b, zero_value);
+                let env_c = tc.env_extend(dead_a, one_value);
+                assert_eq!(tc.eval(2, env_a, expression), zero_value);
+                assert_eq!(tc.eval(2, env_b, expression), zero_value);
+                assert_eq!(tc.eval(2, env_c, expression), one_value);
+            });
+        });
+    }
+
+    #[test]
+    fn same_bound_variable_level_with_changed_type_stays_distinct() {
+        let export = parse_export_mapped(b"{\"ie\":0,\"sort\":0}\n", Config::default()).unwrap();
+        export.with_ctx(|ctx, cache, _| {
+            ctx.with_tc(EnvLimit::ByIndex(0), cache, |tc| {
+                let one = tc.ctx.succ(ZERO);
+                let sort = tc.ctx.mk_sort(ZERO);
+                let outer_under_pi = tc.ctx.mk_var(1);
+                let expression = tc.ctx.mk_pi(sort, outer_under_pi);
+                let ty_a = tc.mk_sort_hc(ZERO);
+                let ty_b = tc.mk_sort_hc(one);
+                let value_a = tc.mk_bvar_hc(0, ty_a);
+                let value_b = tc.mk_bvar_hc(0, ty_b);
+                let env_a = tc.env_extend(EMPTY_ENV, value_a);
+                let env_b = tc.env_extend(EMPTY_ENV, value_b);
+                let ctx_a = tc.ctx_extend(crate::checker::value::EMPTY_CTX, ty_a);
+                let ctx_b = tc.ctx_extend(crate::checker::value::EMPTY_CTX, ty_b);
+                let a = tc.infer_value(InferFlag::InferOnly, 1, env_a, ctx_a, expression);
+                let b = tc.infer_value(InferFlag::InferOnly, 1, env_b, ctx_b, expression);
+                assert_eq!(a, ty_a);
+                assert_eq!(b, ty_b);
+            });
+        });
+    }
+
+    #[test]
+    fn equal_selected_values_under_changed_universes_stay_distinct() {
+        let export = parse_export_mapped(b"{\"ie\":0,\"sort\":0}\n", Config::default()).unwrap();
+        export.with_ctx(|ctx, cache, _| {
+            ctx.with_tc(EnvLimit::ByIndex(0), cache, |tc| {
+                let name = tc.ctx.str1("single_binding_u");
+                let u = tc.ctx.alloc_level(Level::Param(name));
+                let one = tc.ctx.succ(ZERO);
+                let ks = tc.ctx.alloc_levels(&[u]);
+                let vs_a = tc.ctx.alloc_levels(&[ZERO]);
+                let vs_b = tc.ctx.alloc_levels(&[one]);
+                let ls_a = tc.intern_level_sub(ks, vs_a);
+                let ls_b = tc.intern_level_sub(ks, vs_b);
+                let base_a = tc.lsub_base(Some(ls_a));
+                let base_b = tc.lsub_base(Some(ls_b));
+                let value = tc.mk_sort_hc(ZERO);
+                let expected_b = tc.mk_sort_hc(one);
+                let env_a = tc.env_extend(base_a, value);
+                let env_b = tc.env_extend(base_b, value);
+                let sort = tc.ctx.mk_sort(ZERO);
+                let body = tc.ctx.mk_sort(u);
+                let lambda = tc.ctx.mk_lambda(sort, body);
+                let var = tc.ctx.mk_var(0);
+                let expression = tc.ctx.mk_app(lambda, var);
+                assert_eq!(tc.eval(1, env_a, expression), value);
+                assert_eq!(tc.eval(1, env_b, expression), expected_b);
+            });
+        });
+    }
+}
