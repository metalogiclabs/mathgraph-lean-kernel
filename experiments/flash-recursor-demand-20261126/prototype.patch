+#[cfg(test)]
+mod demanded_prefix_checks {
+    use super::*;
+    use crate::checker::env::EnvLimit;
+    use crate::checker::tc::InferFlag::Check;
+    use crate::checker::value::{EMPTY_CTX, EMPTY_ENV};
+    use crate::config::Config;
+    use crate::frontend::parser::parse_export_file;
+    use crate::outcome::Rejection;
+    use std::io;
+    use std::panic::{AssertUnwindSafe, catch_unwind};
+
+    #[test]
+    fn erased_rule_argument_keeps_scope_and_still_requires_typing() {
+        let export = parse_export_file(io::empty(), Config::default(), 0).unwrap();
+        export.with_ctx(|ctx, cache, _| {
+            let one = ctx.succ(ctx.zero());
+            let typ = ctx.mk_sort(one);
+            let [v0, v1, v2] = [0, 1, 2].map(|i| ctx.mk_var(i));
+            // The rule is fun (A : Type) (x y : A) => x.
+            let rule = ctx.mk_lambda(v1, v1);
+            let rule = ctx.mk_lambda(v0, rule);
+            let rule = ctx.mk_lambda(typ, rule);
+            let applied = ctx.mk_app(rule, v2);
+            let applied = ctx.mk_app(applied, v1);
+            let valid = ctx.mk_app(applied, v0);
+            let invalid = ctx.mk_app(applied, typ);
+            ctx.with_tc(EnvLimit::ByIndex(0), cache, |tc| {
+                let sort = tc.eval(0, EMPTY_ENV, typ);
+                let a = tc.mk_bvar_hc(0, sort);
+                let x = tc.mk_bvar_hc(1, a);
+                let y = tc.mk_bvar_hc(2, a);
+                let env = tc.env_extend(EMPTY_ENV, a);
+                let env = tc.env_extend(env, x);
+                let env = tc.env_extend(env, y);
+                let context = tc.ctx_extend(EMPTY_CTX, sort);
+                let context = tc.ctx_extend(context, a);
+                let context = tc.ctx_extend(context, a);
+                let checked = tc.infer_value(Check, 3, env, context, valid);
+                assert!(tc.conv_types_at(3, checked, a));
+                let head = tc.eval(3, EMPTY_ENV, rule);
+                let result = tc.eval_rule_prefix(3, env, head, &[v0, v1, v2]);
+                assert!(tc.def_eq_at(3, result, x));
+                assert!(!tc.def_eq_at(3, result, y));
+                let failure = catch_unwind(AssertUnwindSafe(|| {
+                    tc.infer_value(Check, 3, env, context, invalid);
+                })).expect_err("unused ill-typed argument must be rejected");
+                assert!(failure.is::<Rejection>());
+            });
+        });
+    }
+}
