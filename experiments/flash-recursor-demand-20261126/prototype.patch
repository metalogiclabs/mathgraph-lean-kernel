+    // Apply a validated rule's parameter/motive/minor prefix. A binder still
+    // extends the environment even when its value is syntactically unused.
+    fn eval_rule_prefix(&mut self, depth: u32, env: E, mut f: V, rev_args: &[ExprId]) -> V {
+        let mut remaining = rev_args.len();
+        while remaining > 0 {
+            if let Value::Lam { body: closure, .. } = self.val(f) {
+                let mut bindings = closure.env;
+                let mut body = closure.body;
+                loop {
+                    remaining -= 1;
+                    let value = if self.ctx.ignores_binder(body) {
+                        self.placeholder()
+                    } else {
+                        self.eval(depth, env, rev_args[remaining])
+                    };
+                    bindings = self.env_extend(bindings, value);
+                    match self.ctx.ex(body) {
+                        Expr::Lambda { body: next, .. } if remaining > 0 => body = next,
+                        _ => break,
+                    }
+                }
+                f = self.eval(depth, bindings, body);
+            } else {
+                remaining -= 1;
+                let value = self.eval(depth, env, rev_args[remaining]);
+                f = self.apply(depth, f, value);
+            }
+        }
+        f
+    }
