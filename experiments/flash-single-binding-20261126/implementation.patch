+#[test]
+fn unary_capture_cache_preserves_universe_substitution() -> Result<(), Box<dyn Error>> {
+    use crate::{tc::InferFlag::Check, value::{self, Value}};
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let zero = tc.ctx.zero();
+        let one = tc.ctx.succ(zero);
+        let u = tc.ctx.param_quick("unary_cache_u");
+        let ks = tc.ctx.alloc_levels_slice(&[u]);
+        let vs0 = tc.ctx.alloc_levels_slice(&[zero]);
+        let vs1 = tc.ctx.alloc_levels_slice(&[one]);
+        let ls0 = tc.arena.alloc(value::LevelSub { ks, vs: vs0 });
+        let ls1 = tc.arena.alloc(value::LevelSub { ks, vs: vs1 });
+        let base0 = tc.arena.alloc(value::Env::Nil { lsub: Some(ls0), hash: 0 });
+        let base1 = tc.arena.alloc(value::Env::Nil { lsub: Some(ls1), hash: 0 });
+        let selected = value::mk_sort(tc.arena, zero);
+        let typ = value::mk_sort(tc.arena, one);
+        let env0 = tc.env_extend(base0, selected);
+        let env1 = tc.env_extend(base1, selected);
+        let ctx = value::ctx_extend(tc.arena, tc.empty_ctx(), typ);
+        let binder = tc.ctx.mk_sort(u);
+        let outer = tc.ctx.mk_var(1);
+        let expr = tc.ctx.mk_lambda(binder, outer);
+        for (env, expected) in [(env0, zero), (env1, one), (env0, zero)] {
+            let inferred = tc.infer_value(Check, 1, env, ctx, expr);
+            let Value::Pi { domain: Value::Sort { level, .. }, .. } = inferred else { panic!("expected function type") };
+            assert_eq!(*level, expected);
+        }
+    }))
+}
