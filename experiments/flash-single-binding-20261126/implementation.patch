+#[test]
+fn unary_capture_cache_preserves_selected_binding() -> Result<(), Box<dyn Error>> {
+    use crate::value;
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let zero = tc.ctx.zero();
+        let one = tc.ctx.succ(zero);
+        let selected = value::mk_sort(tc.arena, zero);
+        let changed = value::mk_sort(tc.arena, one);
+        let prop = tc.ctx.prop();
+        let outer = tc.ctx.mk_var(2);
+        let fun = tc.ctx.mk_lambda(prop, outer);
+        let expr = tc.ctx.mk_app(fun, prop);
+        let empty = tc.empty_env();
+        let parent = tc.env_extend(empty, selected);
+        let first = tc.env_extend(parent, selected);
+        let irrelevant_change = tc.env_extend(parent, changed);
+        let other_parent = tc.env_extend(empty, changed);
+        let relevant_change = tc.env_extend(other_parent, selected);
+        assert!(std::ptr::eq(tc.eval(2, first, expr), selected));
+        assert!(std::ptr::eq(tc.eval(2, irrelevant_change, expr), selected));
+        assert!(std::ptr::eq(tc.eval(2, relevant_change, expr), changed));
+    }))
+}
