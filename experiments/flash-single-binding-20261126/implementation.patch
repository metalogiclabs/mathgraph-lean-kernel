+#[test]
+fn unary_capture_type_cache_preserves_carrier() -> Result<(), Box<dyn Error>> {
+    use crate::{tc::InferFlag::Check, value::{self, Value}};
+    test_export_file(None, |export| export.with_tc(crate::env::EnvLimit::Empty, |tc| {
+        let zero = tc.ctx.zero();
+        let one = tc.ctx.succ(zero);
+        let two = tc.ctx.succ(one);
+        let prop = value::mk_sort(tc.arena, zero);
+        let typ = value::mk_sort(tc.arena, one);
+        let typ1 = value::mk_sort(tc.arena, two);
+        let var = tc.ctx.mk_var(0);
+        let identity = tc.ctx.mk_lambda(var, var);
+        let empty = tc.empty_env();
+        let env0 = tc.env_extend(empty, prop);
+        let env1 = tc.env_extend(empty, typ);
+        let ctx = tc.empty_ctx();
+        let ctx0 = value::ctx_extend(tc.arena, ctx, typ);
+        let ctx1 = value::ctx_extend(tc.arena, ctx, typ1);
+        for (env, ctx, expected) in [(env0, ctx0, zero), (env1, ctx1, one), (env0, ctx0, zero)] {
+            let inferred = tc.infer_value(Check, 1, env, ctx, identity);
+            let Value::Pi { domain: Value::Sort { level, .. }, .. } = inferred else { panic!("expected identity type") };
+            assert_eq!(*level, expected);
+        }
+    }))
+}
