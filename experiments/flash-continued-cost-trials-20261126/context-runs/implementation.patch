+
+    #[test]
+    fn compressed_context_lookup_matches_parent_walk_across_branches() {
+        let mut vals = Vals::new();
+        let sort = vals.mk_sort(ZERO);
+        let mut last = EMPTY_CTX;
+        for i in 1..2500u32 {
+            let parent = if i % 17 == 0 { CtxId(i / 3) } else { last };
+            let ty = vals.mk_head(RigidHead::BVar(i, sort), false);
+            last = vals.ctx_extend(parent, ty);
+            for idx in [0u16, 1, 2, 7, 16, 17, 63, 127, 1024] {
+                let mut reference = last;
+                let mut remaining = idx;
+                while reference != EMPTY_CTX && remaining > 0 {
+                    reference = vals.ctxs[reference.index()].parent;
+                    remaining -= 1;
+                }
+                let expected = (reference != EMPTY_CTX).then(|| vals.ctxs[reference.index()].ty);
+                assert_eq!(vals.ctx_lookup(last, idx), expected, "context {i}, index {idx}");
+            }
+        }
+    }
+
+    #[test]
+    fn context_spans_saturate_and_reset_without_changing_lookup() {
+        let mut vals = Vals::new();
+        let sort = vals.mk_sort(ZERO);
+        let mut ctx = EMPTY_CTX;
+        let mut types = Vec::new();
+        for i in 0..u32::from(u16::MAX) + 3 {
+            let ty = vals.mk_head(RigidHead::BVar(i, sort), false);
+            types.push(ty);
+            ctx = vals.ctx_extend(ctx, ty);
+        }
+        assert_eq!(vals.ctx_runs[ctx.index()], u16::MAX);
+        for idx in [0u16, 1, 63, 32767, 65534, 65535] {
+            assert_eq!(vals.ctx_lookup(ctx, idx), Some(types[types.len() - 1 - usize::from(idx)]));
+        }
+        vals.clear();
+        assert_eq!(vals.ctx_runs, [0]);
+        let fresh = vals.mk_sort(ZERO);
+        let ctx = vals.ctx_extend(EMPTY_CTX, fresh);
+        assert_eq!(vals.ctx_lookup(ctx, 0), Some(fresh));
+        assert_eq!(vals.ctx_lookup(ctx, 1), None);
+    }
 }
