+}
+
+impl Drop for EnvTrace {
+    fn drop(&mut self) {
+        eprintln!("MG_ENV_TRACE {{\"cons_new\":{},\"skips\":{:?},\"frames\":{:?},\"context_new\":{},\"context_lookups\":{},\"context_requested_steps\":{}}}", self.cons_new, self.skips, self.frames, self.context_new, self.context_lookups, self.context_requested_steps);
+    }
+}
+
+thread_local! {
+    pub(crate) static ENV_TRACE: std::cell::RefCell<EnvTrace> = const {
+        std::cell::RefCell::new(EnvTrace { cons_new: 0, skips: [0; 64], frames: [0; 4], context_new: 0, context_lookups: 0, context_requested_steps: 0 })
+    };
+}
